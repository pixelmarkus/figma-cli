{
  "name": "FigCli",
  "id": "figma-cli-bridge",
  "api": "1.0.0",
  "main": "code.js",
  "ui": "ui.html",
  "capabilities": [],
  "permissions": [
    "teamlibrary"
  ],
  "enableProposedApi": false,
  "editorType": [
    "figma",
    "figjam"
  ],
  "documentAccess": "dynamic-page",
  "networkAccess": {
    "allowedDomains": [
      "*"
    ],
    "reasoning": "Connects to local CLI daemon for command execution"
  },
  "menu": [
    {
      "name": "Connect",
      "command": "connect"
    },
    {
      "name": "Connect with status window",
      "command": "status"
    },
    {
      "separator": true
    },
    {
      "name": "Disconnect",
      "command": "disconnect"
    }
  ],
  "relaunchButtons": [
    {
      "command": "reconnect",
      "name": "Reconnect figma-cli"
    }
  ]
}
